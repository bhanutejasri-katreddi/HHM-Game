# ==========================================
# FRONTEND CONFIGURATION (client/.env)
# ==========================================

# The URL where your backend (Node.js/Socket.io) is hosted.
# For local development: http://localhost:3001
# For production (e.g., Render/Railway): https://your-backend-url.onrender.com
VITE_SERVER_URL=http://localhost:3001

# ==========================================
# BACKEND CONFIGURATION (server/.env)
# ==========================================

# The port the backend should listen on.
PORT=3001

# REQUIRED: Neon Postgres connection string.
# Use the POOLED connection string from Neon (host contains "-pooler") for the running app.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign admin JWTs (set a strong value in production)
JWT_SECRET=change_me

