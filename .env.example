# ==========================================
# FRONTEND CONFIGURATION (client/.env)
# ==========================================

# The URL where your backend (Node.js/Socket.io) is hosted.
# For local development: http://localhost:3001
# For production (e.g., Render/Railway): https://your-backend-url.onrender.com
VITE_SERVER_URL=http://localhost:3001

# ==========================================
# BACKEND CONFIGURATION (server/.env)
# ==========================================

# The port the backend server should listen on.
PORT=3001

# (Optional) Absolute path to store the SQLite database.
# Default: ./buzzer.db
# If deploying to Render/Railway with a persistent disk, point this to the mounted volume path.
# Example: /opt/render/project/src/data/buzzer.db
DB_PATH=buzzer.db
