# Backend environment variables (server/.env)

# REQUIRED: Neon Postgres connection string.
# Use the POOLED connection string (host contains "-pooler") for the running app.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: use the DIRECT (non-pooled) string (no "-pooler" in host) when running
# `npx prisma migrate dev` / `prisma migrate deploy`.

# Port the backend listens on
PORT=3001

# Secret used to sign admin JWTs (set a strong value in production)
JWT_SECRET=change_me
